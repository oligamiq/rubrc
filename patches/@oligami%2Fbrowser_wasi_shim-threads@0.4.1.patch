n    allocator: AllocatorUseArrayBufferObject;\n    baseCall: BaseCallTransportObject;\n    lock_fds: SharedArrayBuffer;\n    fds_len_and_num: SharedArrayBuffer;\n    fd_func_sig: SharedArrayBuffer;\n  };\n\n/**\n * WASIFarmRefUseArrayBuffer implements the `WASIFarmRef` interface using `SharedArrayBuffer`\n * to proxy WASI system calls to the host-side `WASIFarmPark`.\n */\n// Transmittable objects to communicate with Park\nexport class WASIFarmRefUseArrayBuffer extends WASIFarmRef {\n  // For more information on member variables, see . See /park.ts\n  allocator: AllocatorUseArrayBuffer;\n  lock_fds: SharedArrayBuffer;\n  // byte 1: fds_len\n  // byte 2: all wasi_farm_ref num\n  fds_len_and_num: SharedArrayBuffer;\n  fd_func_sig: SharedArrayBuffer;\n  private readonly baseCall: BaseCallRefUseArrayBuffer;\n\n  /**\n   * Initializes a new WASIFarmRefUseArrayBuffer.\n   *\n   * @param allocator The serialized allocator state.\n   * @param lock_fds The shared buffer for FD locks.\n   * @param fds_len_and_num The shared buffer for global FD state.\n   * @param fd_func_sig The shared buffer for function signatures.\n   * @param baseCall Cloneable version-2 base-call transport state.\n   * @param fd_close_receiver The serialized state of the FD close notification receiver.\n   * @param stdin The index of the standard input FD.\n   * @param stdout The index of the standard output FD.\n   * @param stderr The index of the standard error FD.\n   * @param default_fds The initial list of allowed FDs.\n   */\n  constructor(\n    allocator: AllocatorUseArrayBufferObject,\n    lock_fds: SharedArrayBuffer,\n    fds_len_and_num: SharedArrayBuffer,\n    fd_func_sig: SharedArrayBuffer,\n    baseCall: BaseCallTransportObject,\n    fd_close_receiver: FdCloseSenderUseArrayBufferObject,\n    stdin: number | undefined,\n    stdout: number | undefined,\n    stderr: number | undefined,\n    default_fds: Array<number>,\n  ) {\n    super(\n      stdin,\n      stdout,\n      stderr,\n      FdCloseSenderUseArrayBuffer.init_self(fd_close_receiver),\n      default_fds,\n    );\n    this.allocator = AllocatorUseArrayBuffer.init_self(allocator);\n    this.lock_fds = lock_fds;\n    this.fd_func_sig = fd_func_sig;\n    this.baseCall = BaseCallRefUseArrayBuffer.init_self(baseCall);\n    this.fds_len_and_num = fds_len_and_num;\n\n    // console.log(\"fds_len_and_num\", this.fds_len_and_num);\n\n    // const view = new Int32Array(this.fds_len_and_num);\n    // Atomics.store(view, 0, 0);\n  }\n\n  get_fds_len(): number {\n    const view = new Int32Array(this.fds_len_and_num);\n    return Atomics.load(view, 0);\n  }\n\n  /**\n   * Reconstructs a reference from a transferred object.\n   *\n   * @param sl The serialized reference state.\n   * @returns A new WASIFarmRefUseArrayBuffer instance.\n   */\n  static init_self(sl: WASIFarmRefUseArrayBufferObject): WASIFarmRef {\n    return new WASIFarmRefUseArrayBuffer(\n      sl.allocator,\n      sl.lock_fds,\n      sl.fds_len_and_num,\n      sl.fd_func_sig,\n      sl.baseCall,\n      sl.fd_close_receiver,\n      sl.stdin,\n      sl.stdout,\n      sl.stderr,\n      sl.default_fds,\n    );\n  }\n\n  // allocate a new id on wasi_farm_ref and return it\n  set_id(): number {\n    const view = new Int32Array(this.fds_len_and_num);\n    const id = Atomics.add(view, 1, 1);\n    this.id = id;\n    return id;\n  }\n\n  /**\n   * Registers this reference ID in the Park's map for each supplied fd.\n   *\n   * This synchronous call blocks on `Atomics.wait`, so it must run in a Worker\n   * or another agent where blocking is allowed, never on the agent running the\n   * asynchronous Park listener. Repeating an fd already mapped to this\n   * instance's internal reference ID is idempotent. The transport copies the\n   * encoded fd words before publication; the caller retains no shared payload\n   * ownership after the call returns.\n   *\n   * Transport allocation, validation, cancellation, and destruction failures\n   * are thrown to the caller. The method changes only the Park's fd-reference\n   * map; it does not destroy or otherwise own the Park, Animal, or this ref.\n   */\n  set_park_fds_map(fds: Array<number>): void {\n    const words = new Uint32Array([this.id, ...fds]);\n    const payload = new Uint8Array(\n      words.buffer,\n      words.byteOffset,\n      words.byteLength,\n    );\n    this.baseCall.block_call(BaseCallOpcode.SetParkFdsMap, payload);\n  }\n\n  /**\n   * Requests destruction of this reference's Park and its owned listeners.\n   *\n   * This synchronous call blocks on `Atomics.wait`, so it must run in a Worker\n   * or another agent where blocking is allowed, never on the Park listener's\n   * agent. Destruction is idempotent, including concurrent owner-side and wire\n   * requests. The empty request carries no caller-owned shared payload, and the\n   * transport releases its request storage before returning.\n   *\n   * Capacity or transport failures before idempotent destruction handling may\n   * throw; cancellation caused by an already-destroyed Park completes\n   * idempotently. This method does not destroy the calling ref, its Animal, or\n   * external Workers that hold another reference.\n   */\n  destroy_park(): void {\n    this.baseCall.block_call(BaseCallOpcode.DestroyPark, new Uint8Array());\n  }\n\n  /**\n   * Invokes the Park's configured unknown-function callback with `arg`.\n   *\n   * This synchronous call blocks on `Atomics.wait`, so it must run in a Worker\n   * or another agent where blocking is allowed, never on the agent running the\n   * asynchronous Park listener. Calls are not idempotent: a dispatched callback\n   * may have side effects and must not be retried blindly. Arguments are strictly\n   * encoded and copied into transport-owned storage. An `undefined` callback\n   * result is returned without decoding; otherwise response bytes are copied out\n   * and their shared allocation is released before this method decodes them.\n   *\n   * Bounded-capacity, strict-codec, remote callback, allocation, cancellation,\n   * and destruction failures are thrown to the caller. The method invokes only\n   * the callback and does not destroy the Park, Animal, or this ref.\n   */\n  call_unknown_fn(arg: unknown): unknown {\n    const arg_bytes = encodeStrictJsonValue(arg);\n    const ret_bytes = this.baseCall.block_call(\n      BaseCallOpcode.CallUnknownFn,\n      arg_bytes,\n    );\n    return ret_bytes === undefined\n      ? undefined\n      : decodeStrictJsonValue(ret_bytes);\n  }\n\n  key: number = Math.round(Math.random() * 100);\n\n  private lock_fd(fd: number) {\n    const view = new Int32Array(this.lock_fds, fd * 12);\n    // eslint-disable-next-line no-constant-condition\n    while (true) {\n      const now_value = Atomics.load(view, 0);\n      if (now_value !== 0) {\n        const value = Atomics.wait(view, 0, now_value);\n        if (value === \"timed-out\") {\n          console.error(\"lock_fd timed-out\");\n          continue;\n        }\n      }\n      const old = Atomics.compareExchange(view, 0, 0, 1);\n      if (old === 0) {\n        return;\n      }\n    }\n  }\n\n  private release_fd(fd: number) {\n    // console.log(\"release_fd\", fd);\n    const view = new Int32Array(this.lock_fds, fd * 12);\n    const before = Atomics.exchange(view, 0, 0);\n    if (before !== 1) {\n      console.error(\"what happened? before\", before);\n    }\n    Atomics.notify(view, 0, 1);\n  }\n\n  private lock_double_fd(fd1: number, fd2: number) {\n    // console.log(\"lock_double_fd\", fd1, fd2);\n    if (fd1 === fd2) {\n      this.lock_fd(fd1);\n      return;\n    }\n    const view = new Int32Array(this.lock_fds);\n    // eslint-disable-next-line no-constant-condition\n    while (true) {\n      const now_value1 = Atomics.load(view, fd1 * 3);\n      const value = Atomics.wait(view, fd1 * 3, now_value1);\n      if (value === \"timed-out\") {\n        console.error(\"lock_double_fd timed-out\");\n        continue;\n      }\n      const old1 = Atomics.exchange(view, fd1 * 3, 2);\n      if (old1 === 0) {\n        const now_value2 = Atomics.load(view, fd2 * 3);\n        if (now_value2 === 2) {\n          // It's nearly deadlocked.\n          if (fd1 < fd2) {\n            // release fd1\n            Atomics.store(view, fd1 * 3, 0);\n            Atomics.notify(view, fd1 * 3, 1);\n            continue;\n          }\n        }\n        const value = Atomics.wait(view, fd2 * 3, now_value2);\n        if (value === \"timed-out\") {\n          console.error(\"lock_double_fd timed-out\");\n          continue;\n        }\n        const old2 = Atomics.exchange(view, fd2 * 3, 2);\n        if (old2 === 0) {\n          return;\n        }\n        Atomics.store(view, fd1 * 3, 0);\n        Atomics.notify(view, fd1 * 3, 1);\n      }\n    }\n  }\n\n  private release_double_fd(fd1: number, fd2: number) {\n    // console.log(\"release_double_fd\", fd1, fd2);\n    if (fd1 === fd2) {\n      this.release_fd(fd1);\n      return;\n    }\n    const view = new Int32Array(this.lock_fds);\n    Atomics.store(view, fd1 * 3, 0);\n    Atomics.notify(view, fd1 * 3, 1);\n    Atomics.store(view, fd2 * 3, 0);\n    Atomics.notify(view, fd2 * 3, 1);\n  }\n\n  private invoke_fd_func(fd: number): boolean {\n    if (fd === undefined) {\n      return false;\n    }\n    const view = new Int32Array(this.lock_fds, fd * 12);\n    Atomics.store(view, 2, 1);\n    Atomics.store(view, 1, 0);\n    const n = Atomics.notify(view, 1);\n    if (n === 1) {\n      return true;\n    }\n    if (n === 0) {\n      const len = this.get_fds_len();\n      if (len <= fd) {\n        console.error(\"invoke_fd_func notify len failed:\", n);\n        Atomics.store(view, 2, 0);\n        Atomics.store(view, 1, 1);\n        return false;\n      }\n      console.warn(\"invoke_func_loop is late\");\n      return true;\n    }\n    console.error(\"invoke_fd_func notify too:\", n);\n    return false;\n  }\n\n  private wait_fd_func(fd: number) {\n    // console.log(\"wait_fd_func\", fd);\n    const view = new Int32Array(this.lock_fds, fd * 12);\n    const value = Atomics.wait(view, 2, 1);\n    if (value === \"timed-out\") {\n      console.error(\"wait call park_fd_func timed-out\");\n    }\n  }\n\n  private call_fd_func(fd: number): boolean {\n    if (!this.invoke_fd_func(fd)) {\n      return false;\n    }\n    // console.log(\"call_fd_func\", fd);\n    this.wait_fd_func(fd);\n    // console.log(\"### call_fd_func released\", fd);\n    return true;\n  }\n\n  private get_error(fd: number): number {\n    const func_sig_view_i32 = new Int32Array(\n      this.fd_func_sig,\n      fd * fd_func_sig_bytes,\n    );\n    const errno_offset = fd_func_sig_u32_size - 1;\n    // console.log(\"get_error: offset\", errno_offset);\n    return Atomics.load(func_sig_view_i32, errno_offset);\n  }\n\n  fd_advise(fd: number): number {\n    this.lock_fd(fd);\n\n    const func_sig_view_u32 = new Uint32Array(\n      this.fd_func_sig,\n      fd * fd_func_sig_bytes,\n    );\n\n    Atomics.store(func_sig_view_u32, 0, 7);\n    Atomics.store(func_sig_view_u32, 1, fd);\n\n    if (!this.call_fd_func(fd)) {\n      this.release_fd(fd);\n      return wasi.ERRNO_BADF;\n    }\n\n    const error = this.get_error(fd);\n\n    this.release_fd(fd);\n\n    return error;\n  }\n\n  fd_allocate(fd: number, offset: bigint, len: bigint): number {\n    this.lock_fd(fd);\n\n    const bytes_offset = fd * fd_func_sig_bytes;\n    const func_sig_view_u32 = new Uint32Array(this.fd_func_sig, bytes_offset);\n    const func_sig_view_u64 = new BigUint64Array(\n      this.fd_func_sig,\n      bytes_offset,\n    );\n\n    Atomics.store(func_sig_view_u32, 0, 8);\n    Atomics.store(func_sig_view_u32, 1, fd);\n    Atomics.store(func_sig_view_u64, 1, offset);\n    Atomics.store(func_sig_view_u64, 2, len);\n\n    if (!this.call_fd_func(fd)) {\n      this.release_fd(fd);\n      return wasi.ERRNO_BADF;\n    }\n\n    const error = this.get_error(fd);\n\n    this.release_fd(fd);\n\n    return error;\n  }\n\n  fd_close(fd: number): number {\n    this.lock_fd(fd);\n\n    const bytes_offset = fd * fd_func_sig_bytes;\n    const func_sig_view_u32 = new Uint32Array(this.fd_func_sig, bytes_offset);\n\n    Atomics.store(func_sig_view_u32, 0, 9);\n    Atomics.store(func_sig_view_u32, 1, fd);\n\n    // console.log(\"fd_close: ref\", fd);\n\n    if (!this.call_fd_func(fd)) {\n      this.release_fd(fd);\n      return wasi.ERRNO_BADF;\n    }\n\n    // console.log(\"fd_close: ref2\", fd);\n\n    const error = this.get_error(fd);\n\n    this.release_fd(fd);\n\n    // console.log(\"fd_close: ref3\", fd);\n\n    return error;\n  }\n\n  fd_datasync(fd: number): number {\n    this.lock_fd(fd);\n\n    const bytes_offset = fd * fd_func_sig_bytes;\n    const func_sig_view_u32 = new Uint32Array(this.fd_func_sig, bytes_offset);\n\n    Atomics.store(func_sig_view_u32, 0, 10);\n    Atomics.store(func_sig_view_u32, 1, fd);\n\n    if (!this.call_fd_func(fd)) {\n      this.release_fd(fd);\n      return wasi.ERRNO_BADF;\n    }\n\n    const error = this.get_error(fd);\n\n    this.release_fd(fd);\n\n    return error;\n  }\n\n  fd_fdstat_get(fd: number): [wasi.Fdstat | undefined, number] {\n    this.lock_fd(fd);\n\n    const bytes_offset = fd * fd_func_sig_bytes;\n    const func_sig_view_u8 = new Uint8Array(this.fd_func_sig, bytes_offset);\n    const func_sig_view_u16 = new Uint16Array(this.fd_func_sig, bytes_offset);\n    const func_sig_view_u32 = new Uint32Array(this.fd_func_sig, bytes_offset);\n    const func_sig_view_u64 = new BigUint64Array(\n      this.fd_func_sig,\n      bytes_offset,\n    );\n\n    Atomics.store(func_sig_view_u32, 0, 11);\n    Atomics.store(func_sig_view_u32, 1, fd);\n\n    if (!this.call_fd_func(fd)) {\n      this.release_fd(fd);\n      return [undefined, wasi.ERRNO_BADF];\n    }\n\n    const error = this.get_error(fd);\n\n    if (error !== wasi.ERRNO_SUCCESS) {\n      this.release_fd(fd);\n      return [undefined, error];\n    }\n\n    const fs_filetype = Atomics.load(