-        },
-      );
-    }
-    safeEmit(emit, `${prefix} phase=response\n`);
-    return result;
-  } catch (error) {
-    safeEmit(
-      emit,
-      `${prefix} phase=reject error=${vfsDebugTraceErrorName(error)}\n`,
-    );
-    throw error;
-  }
-}
