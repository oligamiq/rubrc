-): string {
-  const len = root.debugTerminalOutputLen();
-  if (len === 0) return "";
-  const ptr = root.allocBuf(len);
-  try {
-    const read = root.debugReadTerminalOutput(ptr, len);
-    return read === 0 ? "" : new TextDecoder().decode(
-      new Uint8Array(memory.buffer, ptr, read).slice(),
